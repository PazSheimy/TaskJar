# Copy this file to .env.local and fill in the values from the Supabase dashboard:
#   Project Settings -> API Keys
# .env.local is ignored by git, so your keys never get pushed to GitHub.
# On Vercel, add the same three values under Project -> Settings -> Environment Variables.

# Project URL. Safe to be public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable key (older dashboards call it the "anon" key). Safe to be public.
# Not used yet; needed once login is built.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (older dashboards call it "service_role"). NEVER share or commit this.
# Used only on the server to write to the waitlist table.
SUPABASE_SECRET_KEY=

# Only needed to run `npm run db:migrate` from your laptop.
# Supabase dashboard -> Connect (top bar) -> Session pooler -> copy the URI
# and replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=
